{
  "name": "writing-gigs-platform",
  "version": "1.0.0",
  "description": "Online writing classes and gigs platform with enrollment tiers",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --watch src/server --exec ts-node src/server/index.ts",
    "dev:client": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "jest"
  },
  "keywords": [
    "writing",
    "gigs",
    "courses",
    "online",
    "education"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "next": "14.0.4",
    "typescript": "5.3.3",
    "express": "4.18.2",
    "mongoose": "7.6.3",
    "bcrypt": "5.1.1",
    "jsonwebtoken": "9.0.2",
    "dotenv": "16.3.1",
    "cors": "2.8.5",
    "stripe": "13.11.0",
    "axios": "1.6.0",
    "react-hook-form": "7.47.0",
    "react-toastify": "9.1.3",
    "zustand": "4.4.1",
    "date-fns": "2.30.0"
  },
  "devDependencies": {
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@types/node": "20.10.5",
    "@types/express": "4.17.21",
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.16",
    "@types/jsonwebtoken": "9.0.5",
    "ts-node": "10.9.1",
    "nodemon": "3.0.2",
    "concurrently": "8.2.2",
    "tailwindcss": "3.3.6",
    "postcss": "8.4.32",
    "autoprefixer": "10.4.16",
    "eslint": "8.55.0",
    "eslint-config-next": "14.0.4",
    "jest": "29.7.0",
    "@testing-library/react": "14.1.2",
    "@testing-library/jest-dom": "6.1.5"
  }
}

